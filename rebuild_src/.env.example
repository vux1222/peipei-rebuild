# VuxGM Media website/API.
VUXGM_SITE_URL=https://vuxgm.site
VUXGM_API_BASE=https://vuxgm.site/api

# Optional public-key override. Normally leave this unset: on first launch the app
# fetches https://vuxgm.site/api/license/public-key over HTTPS and pins it locally.
# VUXGM_LICENSE_PUBLIC_KEY=BASE64_ED25519_PUBLIC_KEY

# Optional: point directly to your local FFmpeg binary.
# BILISUB_FFMPEG=D:\\ffmpeg-8.1.2-essentials_build\\bin\\ffmpeg.exe

# Optional: kill an FFmpeg process when no log line is produced for this many seconds.
BILISUB_FFMPEG_STALL=600
